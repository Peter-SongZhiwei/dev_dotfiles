fv() {
    local f
    f=$(fzf --preview 'bat --color=always --style=numbers {} 2>/dev/null || cat {}')
    [ -z "$f" ] && return
    local cmd=(nvim "$f")
    echo "${cmd[@]}"  # 调试输出
    history -s "${cmd[@]}" # 命令加入history
    "${cmd[@]}"
}

fcd() {
  local sel
  sel=$(fd --hidden --exclude .git 2>/dev/null || find . -not -path '*/.git/*')
  sel=$(echo "$sel" | fzf --preview '
    if [ -d {} ]; then
      ls -la --color=always {}
    else
      bat --color=always --style=numbers {} 2>/dev/null || cat {}
    fi
  ') || return
  local cmd
  if [ -d "$sel" ]; then
    cmd=(cd "$sel")
  else
    cmd=(cd "$(dirname "$sel")")
  fi
  echo "${cmd[@]}"
  "${cmd[@]}"
  history -s "${cmd[@]}"
  ls -al
}

show_path() {
    local var="${1:-PATH}"
    local val="${!var}"
    [ -z "$val" ] && { printf '%s 未设置或为空\n' "$var"; return; }

    printf '\033[1;33m%s\033[0m\n' "$var"
    local i=0 p
    while IFS= read -r p; do
        i=$((i + 1))
        if [ -z "$p" ]; then
            printf '\033[31m%3d  <空字段!>\033[0m\n' "$i"
        elif [ -d "$p" ]; then
            printf '\033[36m%3d  %s\033[0m\n' "$i" "$p"
        else
            printf '\033[90m%3d  %s  (不存在)\033[0m\n' "$i" "$p"
        fi
    done <<< "${val//:/$'\n'}"
}



# switch sdk
ss() {
    local -A sdks=(
        ["[e200软仿40] stable"]="/home/zte/lpu_config/evas_e200_sdk_cgsl_x86_gcc8_0.2.3.41_bugfix"
        ["[e200实卡] stable"]="/home/zte/lpu_config/epoch-evas_e200_sdk_cgsl_x86_gcc8_0.2.3.44_release_bugfix_0416"
        ["[e200a软仿] 0728"]="/home/zte/lpu_config/daily_e200a_cgsl_x86_gcc8_20260728000000"
        ["[e200a软仿] latest"]="/home/zte/lpu_config/daily_e200a_cgsl_x86_gcc8_20260916000000"
    )

    local selected
    selected=$(
        for key in "${!sdks[@]}"; do
            printf "%s\t%s\n" "$key" "${sdks[$key]}"
        done | sort | fzf \
            --prompt="SDK > " \
            --height=40% \
            --layout=reverse \
            --border \
            --header="当前: ${ETHER_SDK_PATH:-未设置}" \
            --preview='echo {2}' \
            --preview-window=down:1
    )
    [[ -z "$selected" ]] && { echo "已取消"; return 0; }
    # 提取别名（第一列）
    local alias_key
    alias_key=$(echo "$selected" | cut -f1)
    local sdk_path="${sdks[$alias_key]}"

    echo $sdk_path
    if [[ ! -d "$sdk_path" ]]; then
        echo "错误: 路径不存在: $sdk_path"
        return 1
    fi

    export ETHER_SDK_PATH="$sdk_path"
    export ESDK_PATH="$ETHER_SDK_PATH"
    export ClANG_18="$ETHER_SDK_PATH/base_env/hgss/bin"
    export RISCV_HGSS="$ETHER_SDK_PATH/base_env/hgss"
    export VISA_PATH="$ETHER_SDK_PATH/application/visa"

    # PATH / LD_LIBRARY_PATH 去重追加（避免反复 source 时无限膨胀）
    local hgss_bin="$ETHER_SDK_PATH/base_env/hgss/bin"
    local hgss_lib="$ETHER_SDK_PATH/base_env/hgss/lib/"
    [[ ":$PATH:" != *":$hgss_bin:"* ]]             && export PATH="$hgss_bin:$PATH"
    [[ ":$LD_LIBRARY_PATH:" != *":$hgss_lib:"* ]]  && export LD_LIBRARY_PATH="$hgss_lib:/usr/local/python3.10/lib:$LD_LIBRARY_PATH"

    echo "✓ 已切换到: $alias_key"
    echo "  $ETHER_SDK_PATH"
}



