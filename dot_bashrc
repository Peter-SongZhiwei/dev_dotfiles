# ========================================
#  guard & functions
# ========================================
# If not running interactively, don't do anything
case $- in
*i*) ;;
*) return ;;
esac

echo 'load .bashrc'

# 头上添加
path_add() {
  case ":$PATH:" in
    *":$1:"*) ;;
    *) PATH="$1:$PATH" ;;
  esac
}

# LD_LIBRARY_PATH必须export增加导出标记 才能传递给子进程
ld_libary_path_add() {
  case ":$LD_LIBRARY_PATH:" in
    *":$1:"*) ;;
    *) export LD_LIBRARY_PATH="$1:$LD_LIBRARY_PATH" ;;
  esac
}
# ========================================
#  user shell configuration
# ========================================
# Source global definitions
if [ -f /etc/bashrc ]; then
	. /etc/bashrc
fi

# User specific environment
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]
then
    path_add "$HOME/.local/bin"
    path_add "$HOME/bin"
fi

if ! [[ "$PATH" =~ "$HOME/.local/lib/node_modules:" ]]
then
    path_add "$HOME/.local/lib/node_modules"
fi

export PATH
export EDITOR="nvim"
export HISTSIZE=100000
export HISTFILESIZE=100000
# 每次执行prompt -r 读 history
# export PROMPT_COMMAND="history -a; history -r; $PROMPT_COMMAND"

# shell option
shopt -s autocd     # 路径自动cd
shopt -s cdspell    # 自动纠正小拼写错误

# ========================================
#  ZTE export
# ========================================
# co-mind cli
# 敏感密钥独立存放于 ~/.bash_secrets（不受 chezmoi 管理，权限600）
[ -f ~/.bash_secrets ] && source ~/.bash_secrets
# opencode
unset TMOUT
export TORCH_DEVICE_BACKEND_AUTOLOAD=0 # 关闭 torch_lpu
ld_libary_path_add "/usr/local/mpi/lib"
path_add "/usr/local/mpi/bin"

# Machine-specific overrides (SDK path, proxy port, ...). ~/.bashrc.local is NOT managed by chezmoi.
[ -f "$HOME/.bashrc.local" ] && source "$HOME/.bashrc.local"

# SDK paths (ETHER_SDK_PATH is set in ~/.bashrc.local)
if [ -n "${ETHER_SDK_PATH:-}" ]; then
    path_add "$ETHER_SDK_PATH/base_env/hgss/bin"
    export ESDK_PATH=$ETHER_SDK_PATH
    export ClANG_18=$ETHER_SDK_PATH/base_env/hgss/bin
    ld_libary_path_add "$ETHER_SDK_PATH/base_env/hgss/lib"
    export RISCV_HGSS=$ETHER_SDK_PATH/base_env/hgss
    export VISA_PATH=$ETHER_SDK_PATH/application/visa
fi
ld_libary_path_add "/usr/local/python3.10/lib"

# Proxy: enabled only when PROXY_PORT is set in ~/.bashrc.local
if [ -n "${PROXY_PORT:-}" ]; then
    export https_proxy="http://127.0.0.1:${PROXY_PORT}"
    export http_proxy="http://127.0.0.1:${PROXY_PORT}"
    # 不走代理配置 zte网站
    export no_proxy="::1,10.*.*.*,10.0.0.0/8,10.192.45.187,10.234.68.5,10.30.6.48,10.3.76.100,10.40.13.107,10.40.66.240,10.41.13.247,10.54.12.47,10.54.20.104,10.54.20.51,10.54.20.61,10.54.20.73,10.54.20.99,10.57.163.170,10.88.138.100,10.88.138.8,10.88.40.91,10.88.98.10,127.0.0.0/8,127.0.0.1,*.ds.zte.com.cn,.ds.zte.com.cn,ds.zte.com.cn,gerrit.zte.com.cn,gitlab.zte.com.cn,localhost,maas-apigateway.dt.zte.com.cn,nsdlmirrors.zte.com.cn,*.sanechips.com.cn,.sanechips.com.cn,sanechips.com.cn,*.uac.zte.com.cn,*.xydigit.com,.xydigit.com,xydigit.com,*.zte.com.cn,.zte.com.cn,zte.com.cn,*zte.intra,zte.intra"
    export NO_PROXY="$no_proxy"
fi

# ========================================
#  tools initiation && configuration 
# ========================================
# fzf：只启用 Ctrl-R 历史搜索 + Alt-C 目录跳转（不启用 Ctrl-T 文件搜索）
# 注意：不要用 bind 把 Ctrl-T 改绑成普通 readline 函数。fzf 用 `bind -x` 绑定 Ctrl-T，
# 而 bash 5.1 在把 bind -x 的键改绑为普通函数时会清空整个 unix-command 键表，
# 导致 Ctrl-R 报错：bash_execute_unix_command: cannot find keymap for command
# 正确做法：把 FZF_CTRL_T_COMMAND 设为空串，fzf 就不会绑定 Ctrl-T，
# bash 默认的 transpose-chars 保持可用。
FZF_CTRL_T_COMMAND=
eval "$(fzf --bash)" # 已同时包含 key-bindings.bash 和 completion.bash
export FZF_DEFAULT_OPTS='--height 40% --layout=default --info=inline'

# starship只初始化一次
if [[ -z "${__STARSHIP_INITIALIZED:-}" ]]; then
    eval "$(starship init bash)"
    __STARSHIP_INITIALIZED=1
fi
eval "$(zoxide init bash)" # zoxide放到最后

source ~/.bash_aliases

# opencode tui 解压到/tmp再dlopen /tmp为noexec
export TMPDIR=~/.cache/tmp

. "$HOME/.cargo/env"

# opencode
export PATH=/home/zte/.opencode/bin:$PATH
