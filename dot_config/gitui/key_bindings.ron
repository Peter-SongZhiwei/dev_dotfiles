// Vim-style navigation:
//   h/j/k/l -> left/down/up/right, arrows still work as defaults.
// h is normally "open help", so help is moved to F1.
// Note: Ctrl-d is also gitui's default "commit" key inside the
// commit/tag message popup; there the commit action takes precedence.
(
    open_help: Some(( code: F(1), modifiers: "")),

    move_left: Some(( code: Char('h'), modifiers: "")),
    move_down: Some(( code: Char('j'), modifiers: "")),
    move_up: Some(( code: Char('k'), modifiers: "")),
    move_right: Some(( code: Char('l'), modifiers: "")),

    page_up: Some(( code: Char('u'), modifiers: "CONTROL")),
    page_down: Some(( code: Char('d'), modifiers: "CONTROL")),
)
