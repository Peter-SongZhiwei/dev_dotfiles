# =======================
#       layout
# =======================

# 窗口编号从 1 开始
set -g base-index 1
# 窗格编号从 1 开始
setw -g pane-base-index 1
# 关闭窗口后重新排序编号（避免出现编号不连续的情况）
set -g renumber-windows on

# Hide status bar on demand
bind C-s if -F '#{s/off//:status}' 'set status off' 'set status on'


# =======================
#       layout
# =======================

set -g default-terminal xterm-256color # better compability
set-option -ga terminal-overrides ",alacritty*:RGB,xterm-*:RGB,gnome*:RGB"
# 允许发送转义字符(escape sequences) 到外层终端
set-option -g allow-passthrough on
# 所有终端类型以 xterm 开头的终端 都支持剪切板功能
set-option -g terminal-features 'xterm*:clipboard'
# tmux等待Esc键输入的时间从默认的 500 毫秒 缩短到了 10 毫秒
# 按 Alt + A：终端发送 \x1b a （即 Esc + a）tmux 收到一个 \x1b 字符时无法判断是 Esc 还是组合键
set -sg escape-time 10 
# 支持鼠标滚轮
set -g mouse on

# =======================
#       plugins
# =======================

set -g @catppuccin_status_background "none"
set -g @catppuccin_window_status_style "custom"
set -g @catppuccin_window_text " #W"
set -g @catppuccin_window_current_text " #W"
set -g @catppuccin_window_left_separator "#[bg=default,fg=#{@thm_overlay_2}]█#[bg=#{@thm_overlay_2},fg=#{@thm_surface_0}]"
set -g @catppuccin_window_middle_separator "#[fg=#{@thm_overlay_2}]█"
set -g @catppuccin_window_right_separator "#[bg=default,fg=#{@thm_surface_0}]█"
set -g @catppuccin_window_current_left_separator "#[bg=default,fg=#{@thm_mauve}]█#[bg=#{@thm_mauve},fg=#{@thm_bg}]"
set -g @catppuccin_window_current_middle_separator "#[fg=#{@thm_mauve}]█"
set -g @catppuccin_window_current_right_separator "#[bg=default,fg=#{@thm_surface_1}]█"

# Run plugin
run ~/.config/tmux/plugins/catppuccin/catppuccin.tmux

set -g status-position top
set -g status-justify "absolute-centre"
set -g window-status-separator " "
set -g status-left-length 0
set -g status-left "#[fg=#{@thm_fg} bold] [#S] "
set -ga status-left "#{?client_prefix,#[fg=#{@thm_red} bold]PREFIX ,#{?#{==:#{pane_mode},copy-mode},#[fg=#{@thm_yellow} bold]COPY ,#[fg=#{@thm_green} bold]NORMAL }}"
set -g status-right "#{E:@catppuccin_status_date_time}"


# =======================
#       plugins
# =======================

set -g prefix C-a
unbind C-b
bind-key C-a send-prefix

vim_pattern='(\S+/)?g?\.?(view|l?n?vim?x?|fzf)(diff)?(-wrapped)?'
is_vim="ps -o state= -o comm= -t '#{pane_tty}' \
    | grep -iqE '^[^TXZ ]+ +${vim_pattern}$'"
bind-key -n 'C-h' if-shell "$is_vim" 'send-keys C-h'  'select-pane -L'
bind-key -n 'C-j' if-shell "$is_vim" 'send-keys C-j'  'select-pane -D'
bind-key -n 'C-k' if-shell "$is_vim" 'send-keys C-k'  'select-pane -U'
bind-key -n 'C-l' if-shell "$is_vim" 'send-keys C-l'  'select-pane -R'

set-window-option -g mode-keys vi
bind-key -T copy-mode-vi v send-keys -X begin-selection
bind-key -T copy-mode-vi C-v send-keys -X rectangle-toggle
bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel

unbind %   # split-window -h
unbind '"' # split-window
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"

# Rename session and window
unbind "\$" # rename-session
unbind ,    # rename-window
bind r command-prompt -I "#{window_name}" "rename-window '%%'"
bind R command-prompt -I "#{session_name}" "rename-session '%%'"

# Kill pane/window/session shortcuts
unbind & # kill-window
bind x confirm-before -p "kill-pane #P? (y/n)" kill-pane
bind X confirm-before -p "kill-window #W? (y/n)" kill-window
bind C-x confirm-before -p "kill other windows? (y/n)" "kill-window -a"
bind q confirm-before -p "kill-session #S? (y/n)" kill-session

unbind ]
bind ] paste-buffer -p

