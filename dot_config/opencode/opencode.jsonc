{
  "$schema": "https://opencode.ai/config.json",
  // 默认模型：ZTE CoMind MaaS 网关的 deepseek-v4-flash
  "model": "maas-deepseek/deepseek-v4-flash",
  "providers": {
    "maas-deepseek": {
      "name": "MaaS DeepSeek",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        // 注意：baseURL 填到 /v1 即可，包会自动拼接 /chat/completions
        "baseURL": "https://nebulacoder-maas.zte.com.cn/v1",
        "apiKey": "{file:~/.maas_key}"
      },
      "headers": {
        "x-uac-app-id": "643672320122",
        "x-emp-no": "10355455"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "deepseek-v4-flash",
          "limit": { "context": 262144, "output": 65536 },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": { "supported": true }
          },
          // 默认开启思考，effort=max（body 字段会原样合并进请求体）
          "body": {
            "chat_template_kwargs": { "enable_thinking": true },
            "reasoning_effort": "max"
          },
          // 思考强度变体，选择方式：maas-deepseek/deepseek-v4-flash#high
          "variants": [
            { "id": "off", "body": { "chat_template_kwargs": { "enable_thinking": false } } },
            { "id": "minimal", "body": { "chat_template_kwargs": { "enable_thinking": true }, "reasoning_effort": "minimal" } },
            { "id": "low", "body": { "chat_template_kwargs": { "enable_thinking": true }, "reasoning_effort": "low" } },
            { "id": "medium", "body": { "chat_template_kwargs": { "enable_thinking": true }, "reasoning_effort": "medium" } },
            { "id": "high", "body": { "chat_template_kwargs": { "enable_thinking": true }, "reasoning_effort": "high" } },
            { "id": "xhigh", "body": { "chat_template_kwargs": { "enable_thinking": true }, "reasoning_effort": "xhigh" } },
            { "id": "max", "body": { "chat_template_kwargs": { "enable_thinking": true }, "reasoning_effort": "max" } }
          ]
        }
      }
    }
  },
  "mcp": {
    "icenter-mcp": {
      "type": "local",
      "command": ["uvx", "icenter-mcp@latest"],
      "enabled": true,
      "environment": {
        "UV_INDEX_URL": "https://artsz.zte.com.cn/artifactory/api/pypi/public-pypi-virtual/simple",
        "UV_EXTRA_INDEX_URL": "https://artsz.zte.com.cn/artifactory/api/pypi/buildself-release-pypi/simple",
      },
      "timeout": 60000
    }
  }
}
